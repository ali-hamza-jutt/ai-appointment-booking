{
  "name": "server",
  "version": "0.1.0",
  "description": "BookWise AI Express API server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "npm run generate && tsx watch --import ./src/instrumentation.ts src/server.ts",
    "dev:worker": "tsx watch --import ./src/instrumentation.ts src/worker.ts",
    "build": "npm run generate && tsc",
    "start": "node --import ./dist/instrumentation.js dist/server.js",
    "start:worker": "node --import ./dist/instrumentation.js dist/worker.js",
    "typecheck": "npm run generate && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src test evals prisma.config.ts vitest.config.ts",
    "test": "npm run generate && vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "npm run generate && vitest run --project integration",
    "eval": "npm run generate && vitest run --project evals",
    "eval:live": "npm run generate && cross-env EVAL_MODE=live vitest run --project evals",
    "eval:record": "npm run generate && cross-env EVAL_MODE=record vitest run --project evals",
    "postinstall": "prisma generate",
    "generate": "prisma generate && tsoa spec-and-routes",
    "tsoa:routes": "tsoa routes",
    "tsoa:spec": "tsoa spec",
    "tsoa:generate": "tsoa spec-and-routes",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-prometheus": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-express": "^0.70.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-ioredis": "^0.70.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/instrumentation": "^7.9.1",
    "@sentry/node": "^11.0.0",
    "@tsoa/runtime": "6.0.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.8",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsoa/cli": "6.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/web-push": "^3.6.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "prisma": "^7.9.1",
    "supertest": "^7.3.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^5.0.2"
  }
}
