NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
# Set when the web app and API are on sibling subdomains, e.g. .example.com
COOKIE_DOMAIN=
LOG_LEVEL=info
DATABASE_URL=postgresql://bookwise:bookwise@localhost:5432/bookwise?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=bookwise-server
JWT_AUDIENCE=bookwise-web
JWT_ACCESS_TOKEN_TTL_SECONDS=900
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_API_URL=https://api.mistral.ai/v1
MISTRAL_EMBED_MODEL=mistral-embed
AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_HISTORY_MESSAGES=12
# Optional locally; required for the worker. Enables the job queue, shared rate limits and caching.
REDIS_URL=redis://localhost:6379
OUTBOX_RELAY_INTERVAL_MS=1000
AVAILABILITY_CACHE_TTL_SECONDS=60
# Optional: without SMTP, emails (verification, reset, booking notifications) are logged in development.
SMTP_URL=
MAIL_FROM=BookWise <no-reply@bookwise.local>
# Optional: enables "Continue with Google". Redirect URI: {API_PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: Twilio SMS for booking notifications and phone codes. TWILIO_FROM is an E.164
# number or a messaging service SID. Delivery callbacks: {API_PUBLIC_URL}/api/webhooks/twilio/sms-status
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Optional: staff calendar sync. The key encrypts OAuth tokens (openssl rand -base64 32).
# Google reuses GOOGLE_CLIENT_ID/SECRET; register {API_PUBLIC_URL}/api/calendar/oauth/callback
# as a redirect URI with Google and with the Microsoft Entra app below.
TOKEN_ENCRYPTION_KEY=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Optional: deposits and prepayment through Stripe Connect (Express accounts, destination charges).
# Webhook endpoint: {API_PUBLIC_URL}/api/webhooks/stripe. List both signing secrets (comma-separated):
# the account endpoint (checkout.session.*, charge.refunded) and the Connect endpoint (account.updated).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_FEE_PERCENT=0
# Observability (all optional). Prometheus metrics ports for the API and worker:
METRICS_PORT=
WORKER_METRICS_PORT=
# OTLP/HTTP collector base URL, e.g. http://localhost:4318; traces are exported when set.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLE_RATIO=1
SENTRY_DSN=
APP_RELEASE=
