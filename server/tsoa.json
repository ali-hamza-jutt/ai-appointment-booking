{
  "entryFile": "src/app.ts",
  "controllerPathGlobs": ["src/modules/**/*.controller.ts"],
  "noImplicitAdditionalProperties": "throw-on-extras",
  "spec": {
    "outputDirectory": "src/generated",
    "specVersion": 3,
    "basePath": "/api",
    "name": "BookWise AI API",
    "version": "0.1.0",
    "description": "HTTP API for BookWise AI.",
    "tags": [
      {
        "name": "Health",
        "description": "Server availability and status"
      }
    ]
  },
  "routes": {
    "routesDir": "src/generated",
    "middleware": "express",
    "basePath": "/api",
    "esm": true,
    "noWriteIfUnchanged": true
  }
}
