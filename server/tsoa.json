{
  "entryFile": "src/app.ts",
  "controllerPathGlobs": ["src/modules/**/*.controller.ts"],
  "noImplicitAdditionalProperties": "throw-on-extras",
  "spec": {
    "outputDirectory": "src/generated",
    "specVersion": 3,
    "basePath": "/api",
    "name": "BookWise AI API",
    "version": "0.1.0",
    "description": "HTTP API for BookWise AI.",
    "tags": [
      {
        "name": "Authentication",
        "description": "Account registration and access-token issuance"
      },
      {
        "name": "Health",
        "description": "Server availability and status"
      }
    ],
    "securityDefinitions": {
      "jwt": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "routes": {
    "routesDir": "src/generated",
    "middleware": "express",
    "basePath": "/api",
    "authenticationModule": "src/middleware/authentication.ts",
    "esm": true,
    "noWriteIfUnchanged": true
  }
}
