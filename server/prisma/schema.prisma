generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED

  @@map("appointment_status")
}

enum AppointmentSource {
  FORM
  CHAT

  @@map("appointment_source")
}

enum ChatSessionStatus {
  ACTIVE
  CLOSED
  ABANDONED

  @@map("chat_session_status")
}

enum PlatformRole {
  USER
  ADMIN

  @@map("platform_role")
}

enum MembershipRole {
  OWNER
  MANAGER
  STAFF

  @@map("membership_role")
}

enum BusinessVertical {
  SALON
  CLINIC
  CONSULTANT
  SPA_WELLNESS
  FITNESS_STUDIO
  TUTORING
  PET_GROOMING

  @@map("business_vertical")
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM

  @@map("chat_message_role")
}

model User {
  id           String               @id @default(uuid()) @db.Uuid
  email        String               @unique @db.VarChar(254)
  passwordHash String               @map("password_hash") @db.VarChar(255)
  fullName     String               @map("full_name") @db.VarChar(80)
  platformRole PlatformRole         @default(USER) @map("platform_role")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  appointments Appointment[]
  chatSessions ChatSession[]
  memberships  Membership[]
  customers    Customer[]
  invitations  BusinessInvitation[]

  @@map("users")
}

model Business {
  id           String               @id @default(uuid()) @db.Uuid
  slug         String               @unique @db.VarChar(60)
  name         String               @db.VarChar(120)
  vertical     BusinessVertical
  timeZone     String               @map("time_zone") @db.VarChar(100)
  currency     String               @db.Char(3)
  settings     Json                 @default("{}") @db.JsonB
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  locations    Location[]
  memberships  Membership[]
  customers    Customer[]
  invitations  BusinessInvitation[]
  appointments Appointment[]

  @@map("businesses")
}

model Location {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String   @db.VarChar(120)
  address    String?  @db.VarChar(300)
  timeZone   String   @map("time_zone") @db.VarChar(100)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt], map: "locations_business_id_created_at_idx")
  @@map("locations")
}

model Membership {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  businessId String         @map("business_id") @db.Uuid
  role       MembershipRole
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId], map: "memberships_user_id_business_id_key")
  @@index([businessId, role], map: "memberships_business_id_role_idx")
  @@map("memberships")
}

model BusinessInvitation {
  id              String         @id @default(uuid()) @db.Uuid
  businessId      String         @map("business_id") @db.Uuid
  email           String         @db.VarChar(254)
  role            MembershipRole
  invitedByUserId String?        @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime       @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy       User?          @relation(fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([businessId, email], map: "business_invitations_business_id_email_key")
  @@index([email], map: "business_invitations_email_idx")
  @@map("business_invitations")
}

model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  name       String   @db.VarChar(120)
  email      String?  @db.VarChar(254)
  phone      String?  @db.VarChar(32)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([businessId, userId], map: "customers_business_id_user_id_key")
  @@unique([businessId, email], map: "customers_business_id_email_key")
  @@index([businessId, createdAt, id], map: "customers_business_id_created_at_id_idx")
  @@map("customers")
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  businessId      String            @map("business_id") @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  chatSessionId   String?           @unique(map: "appointments_chat_session_id_key") @map("chat_session_id") @db.Uuid
  serviceName     String            @map("service_name") @db.VarChar(120)
  scheduledAt     DateTime          @map("scheduled_at") @db.Timestamptz(3)
  timeZone        String            @default("UTC") @map("time_zone") @db.VarChar(100)
  durationMinutes Int               @default(30) @map("duration_minutes") @db.SmallInt
  status          AppointmentStatus @default(PENDING)
  source          AppointmentSource @default(FORM)
  notes           String?           @db.Text
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatSession     ChatSession?      @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)

  @@index([businessId, scheduledAt], map: "appointments_business_id_scheduled_at_idx")
  @@index([userId, createdAt, id], map: "appointments_user_id_created_at_id_idx")
  @@index([userId, status, createdAt, id], map: "appointments_user_id_status_created_at_id_idx")
  @@index([userId, status, scheduledAt], map: "appointments_user_id_status_scheduled_at_idx")
  @@map("appointments")
}

model ChatSession {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  title          String?           @db.VarChar(120)
  status         ChatSessionStatus @default(ACTIVE)
  bookingContext Json?             @map("booking_context") @db.JsonB
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       ChatMessage[]
  appointment    Appointment?

  @@index([userId, updatedAt, id], map: "chat_sessions_user_id_updated_at_id_idx")
  @@map("chat_sessions")
}

model ChatMessage {
  id               String          @id @default(uuid()) @db.Uuid
  sessionId        String          @map("session_id") @db.Uuid
  clientMessageId  String?         @map("client_message_id") @db.Uuid
  replyToMessageId String?         @map("reply_to_message_id") @db.Uuid
  role             ChatMessageRole
  content          String          @db.Text
  structuredData   Json?           @map("structured_data") @db.JsonB
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  session          ChatSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, clientMessageId], map: "chat_messages_session_id_client_message_id_key")
  @@unique([sessionId, replyToMessageId], map: "chat_messages_session_id_reply_to_message_id_key")
  @@index([sessionId, createdAt, id], map: "chat_messages_session_id_created_at_id_idx")
  @@map("chat_messages")
}
