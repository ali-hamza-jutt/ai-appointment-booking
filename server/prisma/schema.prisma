generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  HELD
  PENDING_PAYMENT
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
  EXPIRED

  @@map("booking_status")
}

enum BookingSource {
  FORM
  CHAT
  STAFF

  @@map("booking_source")
}

enum BookingActorType {
  CUSTOMER
  STAFF
  SYSTEM

  @@map("booking_actor_type")
}

enum ChatSessionStatus {
  ACTIVE
  CLOSED
  ABANDONED

  @@map("chat_session_status")
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("auth_token_purpose")
}

enum PhoneVerificationPurpose {
  LINK
  SIGN_IN

  @@map("phone_verification_purpose")
}

enum KnowledgeSourceKind {
  FAQ
  POLICY
  PREPARATION
  OTHER

  @@map("knowledge_source_kind")
}

enum KnowledgeSourceStatus {
  /// Chunks saved; embeddings not computed yet.
  PENDING
  READY
  FAILED

  @@map("knowledge_source_status")
}

enum PlatformRole {
  USER
  ADMIN

  @@map("platform_role")
}

enum MembershipRole {
  OWNER
  MANAGER
  STAFF

  @@map("membership_role")
}

enum BusinessVertical {
  SALON
  CLINIC
  CONSULTANT
  SPA_WELLNESS
  FITNESS_STUDIO
  TUTORING
  PET_GROOMING

  @@map("business_vertical")
}

enum ServiceBookingType {
  APPOINTMENT
  CLASS

  @@map("service_booking_type")
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM

  @@map("chat_message_role")
}

model User {
  id                 String               @id @default(uuid()) @db.Uuid
  email              String               @unique @db.VarChar(254)
  /// Null for accounts that only sign in with Google.
  passwordHash       String?              @map("password_hash") @db.VarChar(255)
  fullName           String               @map("full_name") @db.VarChar(80)
  platformRole       PlatformRole         @default(USER) @map("platform_role")
  emailVerifiedAt    DateTime?            @map("email_verified_at") @db.Timestamptz(3)
  /// Verified E.164 number; set only after a code confirms it.
  phone              String?              @unique @db.VarChar(16)
  phoneVerifiedAt    DateTime?            @map("phone_verified_at") @db.Timestamptz(3)
  googleSubject      String?              @unique @map("google_subject") @db.VarChar(255)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  refreshTokens      RefreshToken[]
  authTokens         AuthToken[]
  phoneVerifications PhoneVerification[]
  bookings           Booking[]
  chatSessions       ChatSession[]
  memberships        Membership[]
  customers          Customer[]
  invitations        BusinessInvitation[]
  staff              Staff[]

  @@map("users")
}

/// One refresh token per rotation. Tokens issued from the same sign-in share
/// a family, so presenting a rotated token revokes the whole family.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  persistent Boolean   @default(false)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  rotatedAt  DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent  String?   @map("user_agent") @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "refresh_tokens_user_id_idx")
  @@index([familyId], map: "refresh_tokens_family_id_idx")
  @@map("refresh_tokens")
}

/// Single-use email links (verification, password reset); only hashes are stored.
model AuthToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash String           @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose], map: "auth_tokens_user_id_purpose_idx")
  @@map("auth_tokens")
}

/// One-time SMS codes for linking a phone or signing in with it.
model PhoneVerification {
  id         String                   @id @default(uuid()) @db.Uuid
  phone      String                   @db.VarChar(16)
  userId     String?                  @map("user_id") @db.Uuid
  purpose    PhoneVerificationPurpose
  codeHash   String                   @map("code_hash") @db.Char(64)
  attempts   Int                      @default(0)
  expiresAt  DateTime                 @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?                @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, purpose, createdAt], map: "phone_verifications_phone_purpose_created_at_idx")
  @@map("phone_verifications")
}

model Business {
  id               String               @id @default(uuid()) @db.Uuid
  slug             String               @unique @db.VarChar(60)
  name             String               @db.VarChar(120)
  vertical         BusinessVertical
  timeZone         String               @map("time_zone") @db.VarChar(100)
  currency         String               @db.Char(3)
  settings         Json                 @default("{}") @db.JsonB
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  locations        Location[]
  memberships      Membership[]
  customers        Customer[]
  invitations      BusinessInvitation[]
  bookings         Booking[]
  chatSessions     ChatSession[]
  categories       ServiceCategory[]
  services         Service[]
  staff            Staff[]
  resources        Resource[]
  workingHours     WorkingHours[]
  timeOff          TimeOff[]
  closures         BusinessClosure[]
  knowledgeSources KnowledgeSource[]
  knowledgeChunks  KnowledgeChunk[]

  @@map("businesses")
}

model Location {
  id             String          @id @default(uuid()) @db.Uuid
  businessId     String          @map("business_id") @db.Uuid
  name           String          @db.VarChar(120)
  address        String?         @db.VarChar(300)
  timeZone       String          @map("time_zone") @db.VarChar(100)
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services       Service[]
  staffLocations StaffLocation[]
  resources      Resource[]
  workingHours   WorkingHours[]

  @@index([businessId, createdAt], map: "locations_business_id_created_at_idx")
  @@map("locations")
}

model ServiceCategory {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  name       String    @db.VarChar(80)
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services   Service[]

  @@unique([businessId, name], map: "service_categories_business_id_name_key")
  @@index([businessId, sortOrder], map: "service_categories_business_id_sort_order_idx")
  @@map("service_categories")
}

model Service {
  id              String             @id @default(uuid()) @db.Uuid
  businessId      String             @map("business_id") @db.Uuid
  categoryId      String?            @map("category_id") @db.Uuid
  locationId      String?            @map("location_id") @db.Uuid
  name            String             @db.VarChar(120)
  description     String?            @db.VarChar(2000)
  bookingType     ServiceBookingType @default(APPOINTMENT) @map("booking_type")
  capacity        Int                @default(1) @db.SmallInt
  durationMinutes Int                @map("duration_minutes") @db.SmallInt
  priceMinor      Int                @map("price_minor")
  currency        String             @db.Char(3)
  depositMinor    Int?               @map("deposit_minor")
  bufferBeforeMin Int                @default(0) @map("buffer_before_min") @db.SmallInt
  bufferAfterMin  Int                @default(0) @map("buffer_after_min") @db.SmallInt
  isActive        Boolean            @default(true) @map("is_active")
  onlineBookable  Boolean            @default(true) @map("online_bookable")
  sortOrder       Int                @default(0) @map("sort_order")
  /// Per-service overrides of business booking policies.
  policyOverrides Json               @default("{}") @map("policy_overrides") @db.JsonB
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  business        Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category        ServiceCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  location        Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  providers       ServiceProvider[]
  resources       ServiceResource[]
  bookings        Booking[]
  chatDrafts      ChatSession[]      @relation("ChatDraftService")

  @@index([businessId, isActive, sortOrder], map: "services_business_id_is_active_sort_order_idx")
  @@index([categoryId], map: "services_category_id_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "services_name_trgm_idx")
  @@map("services")
}

model Staff {
  id           String            @id @default(uuid()) @db.Uuid
  businessId   String            @map("business_id") @db.Uuid
  userId       String?           @map("user_id") @db.Uuid
  displayName  String            @map("display_name") @db.VarChar(80)
  email        String?           @db.VarChar(254)
  bio          String?           @db.VarChar(1000)
  avatarUrl    String?           @map("avatar_url") @db.VarChar(500)
  isActive     Boolean           @default(true) @map("is_active")
  sortOrder    Int               @default(0) @map("sort_order")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  services     ServiceProvider[]
  locations    StaffLocation[]
  workingHours WorkingHours[]
  timeOff      TimeOff[]
  bookings     Booking[]
  chatDrafts   ChatSession[]     @relation("ChatDraftStaff")

  @@unique([businessId, userId], map: "staff_business_id_user_id_key")
  @@index([businessId, isActive, sortOrder], map: "staff_business_id_is_active_sort_order_idx")
  @@map("staff")
}

/// Which services a staff member performs, with optional per-person overrides.
model ServiceProvider {
  serviceId             String   @map("service_id") @db.Uuid
  staffId               String   @map("staff_id") @db.Uuid
  customDurationMinutes Int?     @map("custom_duration_minutes") @db.SmallInt
  customPriceMinor      Int?     @map("custom_price_minor")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  service               Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff                 Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([serviceId, staffId], map: "service_providers_pkey")
  @@index([staffId], map: "service_providers_staff_id_idx")
  @@map("service_providers")
}

model StaffLocation {
  staffId    String   @map("staff_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([staffId, locationId], map: "staff_locations_pkey")
  @@index([locationId], map: "staff_locations_location_id_idx")
  @@map("staff_locations")
}

/// A room, chair or machine that a service needs; scheduled like a provider.
model Resource {
  id         String            @id @default(uuid()) @db.Uuid
  businessId String            @map("business_id") @db.Uuid
  locationId String            @map("location_id") @db.Uuid
  name       String            @db.VarChar(80)
  capacity   Int               @default(1) @db.SmallInt
  isActive   Boolean           @default(true) @map("is_active")
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location   Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  services   ServiceResource[]

  @@unique([businessId, locationId, name], map: "resources_business_id_location_id_name_key")
  @@index([businessId, isActive], map: "resources_business_id_is_active_idx")
  @@map("resources")
}

model ServiceResource {
  serviceId  String   @map("service_id") @db.Uuid
  resourceId String   @map("resource_id") @db.Uuid
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([serviceId, resourceId], map: "service_resources_pkey")
  @@index([resourceId], map: "service_resources_resource_id_idx")
  @@map("service_resources")
}

/// Weekly recurring shift in the local time of its location (or the business).
/// Several rows per weekday model split shifts and breaks; an end past 24:00
/// is an overnight shift.
model WorkingHours {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  staffId     String    @map("staff_id") @db.Uuid
  locationId  String?   @map("location_id") @db.Uuid
  /// ISO weekday, 1 = Monday … 7 = Sunday.
  weekday     Int       @db.SmallInt
  startMinute Int       @map("start_minute") @db.SmallInt
  endMinute   Int       @map("end_minute") @db.SmallInt
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff       Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  location    Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([businessId, staffId, weekday], map: "working_hours_business_id_staff_id_weekday_idx")
  @@map("working_hours")
}

model TimeOff {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  staffId    String   @map("staff_id") @db.Uuid
  startsAt   DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime @map("ends_at") @db.Timestamptz(3)
  reason     String?  @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([businessId, staffId, startsAt], map: "time_off_business_id_staff_id_starts_at_idx")
  @@map("time_off")
}

/// A whole local day the business is closed, such as a public holiday.
model BusinessClosure {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  date       DateTime @db.Date
  reason     String?  @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date], map: "business_closures_business_id_date_key")
  @@map("business_closures")
}

model Membership {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  businessId String         @map("business_id") @db.Uuid
  role       MembershipRole
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId], map: "memberships_user_id_business_id_key")
  @@index([businessId, role], map: "memberships_business_id_role_idx")
  @@map("memberships")
}

model BusinessInvitation {
  id              String         @id @default(uuid()) @db.Uuid
  businessId      String         @map("business_id") @db.Uuid
  email           String         @db.VarChar(254)
  role            MembershipRole
  invitedByUserId String?        @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime       @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy       User?          @relation(fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([businessId, email], map: "business_invitations_business_id_email_key")
  @@index([email], map: "business_invitations_email_idx")
  @@map("business_invitations")
}

model Customer {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  name       String    @db.VarChar(120)
  email      String?   @db.VarChar(254)
  phone      String?   @db.VarChar(32)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookings   Booking[]

  @@unique([businessId, userId], map: "customers_business_id_user_id_key")
  @@unique([businessId, email], map: "customers_business_id_email_key")
  @@index([businessId, createdAt, id], map: "customers_business_id_created_at_id_idx")
  @@map("customers")
}

/// A provider-side booking. Customers still see these as "appointments".
model Booking {
  id              String            @id @default(uuid()) @db.Uuid
  businessId      String            @map("business_id") @db.Uuid
  /// The booking customer's account, when they have one.
  userId          String?           @map("user_id") @db.Uuid
  customerId      String            @map("customer_id") @db.Uuid
  serviceId       String?           @map("service_id") @db.Uuid
  staffId         String?           @map("staff_id") @db.Uuid
  chatSessionId   String?           @unique(map: "appointments_chat_session_id_key") @map("chat_session_id") @db.Uuid
  /// Snapshot so later catalog edits never rewrite history.
  serviceName     String            @map("service_name") @db.VarChar(120)
  scheduledAt     DateTime          @map("scheduled_at") @db.Timestamptz(3)
  endsAt          DateTime          @map("ends_at") @db.Timestamptz(3)
  timeZone        String            @default("UTC") @map("time_zone") @db.VarChar(100)
  durationMinutes Int               @default(30) @map("duration_minutes") @db.SmallInt
  bufferBeforeMin Int               @default(0) @map("buffer_before_min") @db.SmallInt
  bufferAfterMin  Int               @default(0) @map("buffer_after_min") @db.SmallInt
  /// Start minus buffer before; the provider is unavailable from here.
  occupiedFrom    DateTime          @map("occupied_from") @db.Timestamptz(3)
  /// End plus buffer after.
  occupiedUntil   DateTime          @map("occupied_until") @db.Timestamptz(3)
  /// Bookings sharing a key share the provider's time (seats in one class).
  sessionKey      String            @map("session_key") @db.VarChar(120)
  seats           Int               @default(1) @db.SmallInt
  priceMinor      Int?              @map("price_minor")
  currency        String?           @db.Char(3)
  status          BookingStatus     @default(CONFIRMED)
  source          BookingSource     @default(FORM)
  notes           String?           @db.Text
  holdExpiresAt   DateTime?         @map("hold_expires_at") @db.Timestamptz(3)
  rescheduleCount Int               @default(0) @map("reschedule_count") @db.SmallInt
  cancelledBy     BookingActorType? @map("cancelled_by")
  cancelReason    String?           @map("cancel_reason") @db.VarChar(500)
  cancelledAt     DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  checkedInAt     DateTime?         @map("checked_in_at") @db.Timestamptz(3)
  completedAt     DateTime?         @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service         Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  staff           Staff?            @relation(fields: [staffId], references: [id], onDelete: SetNull)
  chatSession     ChatSession?      @relation("ChatSessionBooking", fields: [chatSessionId], references: [id], onDelete: SetNull)
  /// Chats whose draft currently points at this hold.
  chatDrafts      ChatSession[]     @relation("ChatDraftHold")
  events          BookingEvent[]

  @@index([businessId, scheduledAt], map: "appointments_business_id_scheduled_at_idx")
  @@index([userId, createdAt, id], map: "appointments_user_id_created_at_id_idx")
  @@index([userId, status, createdAt, id], map: "appointments_user_id_status_created_at_id_idx")
  @@index([userId, status, scheduledAt], map: "appointments_user_id_status_scheduled_at_idx")
  @@index([staffId, status, occupiedFrom], map: "bookings_staff_id_status_occupied_from_idx")
  @@index([status, holdExpiresAt], map: "bookings_status_hold_expires_at_idx")
  @@index([customerId, scheduledAt], map: "bookings_customer_id_scheduled_at_idx")
  @@map("bookings")
}

/// Append-only audit trail of every booking state change.
model BookingEvent {
  id          String           @id @default(uuid()) @db.Uuid
  bookingId   String           @map("booking_id") @db.Uuid
  businessId  String           @map("business_id") @db.Uuid
  type        String           @db.VarChar(40)
  fromStatus  BookingStatus?   @map("from_status")
  toStatus    BookingStatus?   @map("to_status")
  actorType   BookingActorType @map("actor_type")
  actorUserId String?          @map("actor_user_id") @db.Uuid
  payload     Json?            @db.JsonB
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  booking     Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt], map: "booking_events_booking_id_created_at_idx")
  @@map("booking_events")
}

/// Side effects written in the same transaction as the change and delivered by a worker.
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  businessId    String?   @map("business_id") @db.Uuid
  type          String    @db.VarChar(80)
  aggregateType String    @map("aggregate_type") @db.VarChar(40)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json      @db.JsonB
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)

  @@index([publishedAt, createdAt], map: "outbox_events_published_at_created_at_idx")
  @@map("outbox_events")
}

model ChatSession {
  id                 String            @id @default(uuid()) @db.Uuid
  businessId         String            @map("business_id") @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  title              String?           @db.VarChar(120)
  status             ChatSessionStatus @default(ACTIVE)
  /// The booking being put together; each id points at a real row.
  draftServiceId     String?           @map("draft_service_id") @db.Uuid
  draftStaffId       String?           @map("draft_staff_id") @db.Uuid
  draftHoldId        String?           @map("draft_hold_id") @db.Uuid
  draftTimeZone      String?           @map("draft_time_zone") @db.VarChar(100)
  draftNotes         String?           @map("draft_notes") @db.VarChar(2000)
  /// Set when the assistant hands the conversation to staff.
  handoffRequestedAt DateTime?         @map("handoff_requested_at") @db.Timestamptz(3)
  handoffReason      String?           @map("handoff_reason") @db.VarChar(500)
  handoffResolvedAt  DateTime?         @map("handoff_resolved_at") @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  business           Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  draftService       Service?          @relation("ChatDraftService", fields: [draftServiceId], references: [id], onDelete: SetNull)
  draftStaff         Staff?            @relation("ChatDraftStaff", fields: [draftStaffId], references: [id], onDelete: SetNull)
  draftHold          Booking?          @relation("ChatDraftHold", fields: [draftHoldId], references: [id], onDelete: SetNull)
  messages           ChatMessage[]
  booking            Booking?          @relation("ChatSessionBooking")

  @@index([userId, updatedAt, id], map: "chat_sessions_user_id_updated_at_id_idx")
  @@index([businessId, handoffRequestedAt], map: "chat_sessions_business_id_handoff_requested_at_idx")
  @@map("chat_sessions")
}

model ChatMessage {
  id               String          @id @default(uuid()) @db.Uuid
  sessionId        String          @map("session_id") @db.Uuid
  clientMessageId  String?         @map("client_message_id") @db.Uuid
  replyToMessageId String?         @map("reply_to_message_id") @db.Uuid
  role             ChatMessageRole
  content          String          @db.Text
  structuredData   Json?           @map("structured_data") @db.JsonB
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  session          ChatSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, clientMessageId], map: "chat_messages_session_id_client_message_id_key")
  @@unique([sessionId, replyToMessageId], map: "chat_messages_session_id_reply_to_message_id_key")
  @@index([sessionId, createdAt, id], map: "chat_messages_session_id_created_at_id_idx")
  @@map("chat_messages")
}

/// FAQs, policies and prep instructions an owner gives the assistant to quote.
model KnowledgeSource {
  id          String                @id @default(uuid()) @db.Uuid
  businessId  String                @map("business_id") @db.Uuid
  title       String                @db.VarChar(200)
  kind        KnowledgeSourceKind   @default(FAQ)
  content     String
  /// Hash of the content the current chunks were built from.
  contentHash String                @map("content_hash") @db.Char(64)
  status      KnowledgeSourceStatus @default(PENDING)
  lastError   String?               @map("last_error") @db.VarChar(500)
  chunkCount  Int                   @default(0) @map("chunk_count")
  embeddedAt  DateTime?             @map("embedded_at") @db.Timestamptz(3)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  business    Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  chunks      KnowledgeChunk[]

  @@index([businessId, updatedAt], map: "knowledge_sources_business_id_updated_at_idx")
  @@map("knowledge_sources")
}

/// A ~500-token passage of a source, with its embedding and a full-text index.
model KnowledgeChunk {
  id         String                       @id @default(uuid()) @db.Uuid
  businessId String                       @map("business_id") @db.Uuid
  sourceId   String                       @map("source_id") @db.Uuid
  position   Int
  content    String
  tokenCount Int                          @map("token_count")
  embedding  Unsupported("vector(1024)")?
  createdAt  DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  business   Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  source     KnowledgeSource              @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, position], map: "knowledge_chunks_source_id_position_key")
  @@index([businessId], map: "knowledge_chunks_business_id_idx")
  @@map("knowledge_chunks")
}
